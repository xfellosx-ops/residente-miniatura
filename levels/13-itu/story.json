  {
   "title": "Urotelio Sitiado",
   "text": "ITU: cistitis (nitrofurantoína/fosfomicina), pielonefritis (7 días si responde). Bacteriuria asintomática: tratar en embarazo y cirugía urológica."
  },
  {
   "title": "Parénquima en Llamas",
   "text": "Sin mejoría en 72 h: TC. Enfisematosa (diabetes): drenaje. Xantogranulomatosa: coraliforme + riñón excluido. TB: piuria estéril."
  },
  {
   "title": "💎 Tratamiento de primera línea en cistitis",
   "text": "Resistencia de E. coli a fluoroquinolonas en EUA: de 3% a 17% en 10 años. Recurrencia en 1–2 semanas: sospechar resistencia y cultivar."
  },
  {
   "title": "💎 Pielonefritis no complicada: duración y ",
   "text": "Si la tinción de Gram sugiere enterococo, agregar amoxicilina. Hospitalizada: ceftriaxona; con resistencia o BLEE, carbapenémico. Pasar a vía oral a las 24–48 h."
  },
  {
   "title": "💎 IVU en el hombre",
   "text": "IVU complicada: 5–10 días según gravedad. En veteranos, 7 días no tuvo más recurrencia que 14. Moxifloxacino no alcanza concentraciones urinarias suficientes."
  },
  {
   "title": "💎 IVU en ERC avanzada",
   "text": "Para curar se necesita concentración urinaria para la cistitis y tisular para la pielonefritis; las concentraciones séricas se correlacionan con las renales."
  },
  {
   "title": "💎 Bacteriuria asociada a sonda",
   "text": "Bacteriuria 3–10% por día de sonda; principal fuente de bacteriemia por gramnegativos hospitalaria. No tamizar ni tratar la bacteriuria asintomática. Suprapúbica o intermitente tiene menos bacteriuria."
  },
  {
   "title": "💎 Candiduria: colonización o infección",
   "text": "Tratar candiduria asintomática solo en neutropénicos, recién nacidos de muy bajo peso y antes de procedimientos urológicos. En trasplantados, solo con obstrucción, procedimiento planeado o síntomas."
  },
  {
   "title": "💎 Tratamiento de la IVU por Candida",
   "text": "Fluconazol de elección para C. albicans: carga 400 mg y 200 mg/día por 14 días. Bolas fúngicas: retiro quirúrgico más fluconazol e irrigación por nefrostomía. C. glabrata tarda 48 h en crecer."
  },
  {
   "title": "💎 Diagnóstico de TB urinaria",
   "text": "Imagen: uréter en sacacorchos o en tallo de pipa, vejiga en dedal y uréter en hoyo de golf. LAM urinario para TB asociada a VIH con CD4 <200."
  }
