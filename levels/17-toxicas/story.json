 "nefrodex": [
  {
   "title": "Guarida de Los Nefrotóxicos",
   "text": "AINE: aferente. Aminoglucósido: megalina, proximal, no oligúrica, día 5–7, pierde K y Mg. Dosis única diaria reduce toxicidad."
  },
  {
   "title": "Intersticio Infiltrado",
   "text": "ICI → NTI (semanas–meses); IBP y AINE como cofactores; esteroides. Calcineurínicos: vasoconstricción aguda y fibrosis crónica. Cisplatino: pierde magnesio."
  },
  {
   "title": "💎 Vancomicina en hemodiálisis: dosis y niv",
   "text": "Vancomicina en HD: carga 20–25 mg/kg, mantenimiento 500 mg–1 g post-HD, valle prediálisis 15–20 mg/L."
  },
  {
   "title": "💎 Necrosis papilar por AINE",
   "text": "Necrosis papilar: diabetes, drepanocitosis, analgésicos/AINE, obstrucción. TC: papilas irregulares; urografía: 'sombra anular'."
  },
  {
   "title": "💎 Prevención de la nefrotoxicidad antibiót",
   "text": "NTA por aminoglucósidos: cambiar a alternativa no nefrotóxica sensible; evitar sumar nefrotóxicos (vancomicina, asa, contraste)."
  },
  {
   "title": "💎 Nefrotoxicidad por aminoglucósidos",
   "text": "Aminoglucósidos: megalina-cubilina → lisosoma/mitocondria; NTA no oligúrica a los 5–7 días con hipoMg e hipoK. Dosis única diaria."
  },
  {
   "title": "💎 Vancomicina: vigilancia y riesgo",
   "text": "Fuente más nueva: consenso 2020; Johnson aún describe la meta de valle. Lesión: NTA, a veces NTI o DRESS. HD de alto flujo si los niveles son muy altos."
  },
  {
   "title": "💎 Tenofovir",
   "text": "TDF entra al túbulo proximal por OAT y daña el ADN mitocondrial: mitocondrias dismórficas. Riesgo: ERC previa, edad, CD4 bajos, dosis y duración. Biopsia si no mejora."
  },
  {
   "title": "💎 Contraste intravenoso y TFG",
   "text": "Johnson coincide: estudios pareados recientes muestran riesgo similar con TC sin contraste. El contraste intraarterial conlleva más riesgo."
  },
  {
   "title": "💎 Vancomicina fuera de diálisis: AUC y nef",
   "text": "Vancomicina SARM grave: guiar por AUC/CIM 400–600 (bayesiano) en vez de valle 15–20. En HD se usa el valle prediálisis."
  }
 ]
